# Database
# Local Postgres:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/petsupplies
#
# Supabase (petsupplies-staging is ca-central-1): paste URI from Dashboard → Database.
# Session pooler (dev/migrate): port 5432, user postgres.<project-ref>
# Transaction pooler (serverless): port 6543, add ?pgbouncer=true if using Prisma migrate on pooler
# Encode special chars in password (? → %3F, @ → %40).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# Supabase (for JWT verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=          # Legacy HS256 projects only (Dashboard → API → JWT Secret)
                               # ES256/RS256 projects verify via SUPABASE_URL JWKS — secret optional
SUPABASE_SERVICE_ROLE_KEY=    # admin key — never expose to frontend

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=        # from `stripe listen` or Stripe dashboard

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000   # for Stripe success/cancel URLs and CORS
FREE_SHIPPING_THRESHOLD_CENTS=5000  # free shipping when cart subtotal >= this (cents)
FLAT_SHIPPING_CENTS=599             # flat rate shipping (cents) when below threshold

# Canada Post (Phase 24 — all optional; omit API key to use flat/threshold fallback only)
# CANADA_POST_API_KEY=
# CANADA_POST_CUSTOMER_NUMBER=
# CANADA_POST_USERNAME=           # defaults to CANADA_POST_CUSTOMER_NUMBER
# CANADA_POST_CONTRACT_ID=
# CANADA_POST_USE_TEST=true       # false = production SOA host
# SHIP_FROM_POSTAL_CODE=K1A0A1   # warehouse origin (Canadian postal)
# SHIPPING_QUOTE_TIMEOUT_MS=4000
# DEFAULT_PACKAGE_WEIGHT_GRAMS=500
# DEFAULT_PACKAGE_L_CM=25
# DEFAULT_PACKAGE_W_CM=20
# DEFAULT_PACKAGE_H_CM=10

CRON_BEARER_TOKEN=replace-with-64-char-hex   # Bearer for POST /jobs/run/* (never commit real secrets)

# Supabase Storage (Phase 26 — admin product image uploads)
SUPABASE_STORAGE_BUCKET=product-images        # bucket name (create in Supabase dashboard, public read)
SUPABASE_PRODUCT_IMAGE_MAX_BYTES=5000000      # 5 MB max per image

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Pet Supplies <orders@example.com>"
