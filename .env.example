# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/petsupplies

# Supabase (for JWT verification)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # admin key — never expose to frontend

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=        # from `stripe listen` or Stripe dashboard

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000   # for Stripe success/cancel URLs and CORS
