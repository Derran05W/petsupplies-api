{
  "name": "petsupplies-api",
  "version": "1.0.0",
  "description": "Hono + Node.js REST API for the petsupplies platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "type-check": "tsc -p tsconfig.check.json",
    "test": "vitest run --passWithNoTests --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20 <21"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "fast-uri": ">=3.1.4 <4.0.0",
      "ws": ">=8.21.0 <9.0.0",
      "vite": ">=8.0.16 <9.0.0",
      "brace-expansion": ">=5.0.7 <6.0.0",
      "js-yaml": ">=4.3.0 <5.0.0",
      "form-data": ">=4.0.6 <5.0.0"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@hono/zod-validator": "^0.7.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.27",
    "jose": "^6.2.3",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "resend": "^6.12.2",
    "stripe": "^22.1.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
